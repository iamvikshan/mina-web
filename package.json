{
  "name": "dashboard",
  "version": "1.2.0",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "bun clean && next build",
    "start": "next start",
    "clean": "rm -rf .next && rm -rf out",
    "prepare": "test -d .git && husky || true",
    "f": "oxfmt --write .",
    "f:check": "oxfmt --check .",
    "lint:fix": "oxlint --fix .",
    "lint": "oxlint .",
    "types": "tsc --project tsconfig.backend.json --noEmit",
    "check": "bun lint && bun types",
    "bs": "mkdir -p scripts && curl -sL https://raw.githubusercontent.com/iamvikshan/.github/main/scripts/bootstrap.sh > scripts/bootstrap.sh && chmod +x scripts/bootstrap.sh && scripts/bootstrap.sh",
    "upd": "sudo apt update && sudo apt upgrade -y && bun upgrade && bun update --latest && bun i && bun f"
  },
  "private": true,
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.0",
    "apexcharts": "^5.16.0",
    "chakra-react-select": "^6.1.3",
    "cookies-next": "^6.1.1",
    "deepmerge-ts": "^7.1.6",
    "framer-motion": "^12.43.0",
    "mongodb": "^7.5.0",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-apexcharts": "^2.1.1",
    "react-calendar": "^6.0.1",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.85.0",
    "react-icons": "^5.7.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-calendar": "^4.1.0",
    "@types/react-dom": "^19.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2"
  }
}
