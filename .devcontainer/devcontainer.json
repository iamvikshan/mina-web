{
  "name": "Ubuntu + Bun + Docker",
  "image": "vikshan/ubuntu-bun:latest",

  "features": {
    "ghcr.io/devcontainers/features/sshd:1.1.0": {
      "version": "latest"
    }
  },
  "runArgs": ["--network=host"],
  "customizations": {
    "vscode": {
      "extensions": [
        "unifiedjs.vscode-mdx",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens",
        "oven.bun-vscode",
        "ms-azuretools.vscode-docker",
        "WakaTime.vscode-wakatime",
        "mongodb.mongodb-vscode",
        "jock.svg",
        "coderabbit.coderabbit-vscode",
        "Lakshmisankar.vscode-lucide-icons",
        "oxc.oxc-vscode"
      ]
    }
  },

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "bun upd && bun bs --default",

  // Set `remoteUser` to `root` to connect as root.
  "remoteUser": "root"
}
